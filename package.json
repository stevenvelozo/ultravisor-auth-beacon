{
	"name": "ultravisor-auth-beacon",
	"version": "1.0.1",
	"description": "Optional Ultravisor beacon that advertises the Authentication capability — login, session validation, beacon-join admission. Pluggable AuthProvider for custom backends (LDAP, OAuth, custom DBs).",
	"main": "source/UltravisorAuthBeacon.cjs",
	"bin": {
		"ultravisor-auth-beacon": "bin/ultravisor-auth-beacon.js"
	},
	"scripts": {
		"start": "node bin/ultravisor-auth-beacon.js",
		"test": "npx mocha -u tdd --exit --timeout 10000 ./test/*_tests*",
		"prepublishOnly": "npm test",
		"postversion": "npx quack release postversion",
		"postpublish": "npx quack release postpublish",
		"publish:docker": "npx quack release publish --image",
		"release:patch": "npx quack release patch",
		"release:minor": "npx quack release minor",
		"release:major": "npx quack release major",
		"release:patch:image": "npx quack release patch --image",
		"release:minor:image": "npx quack release minor --image",
		"release:major:image": "npx quack release major --image"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/stevenvelozo/ultravisor-auth-beacon.git"
	},
	"keywords": [
		"ultravisor",
		"beacon",
		"authentication",
		"authorization",
		"mesh",
		"identity"
	],
	"author": "Steven Velozo <steven@velozo.com>",
	"license": "MIT",
	"dependencies": {
		"ultravisor-beacon": "^1.0.0"
	},
	"devDependencies": {
		"mocha": "^10.4.0",
		"quackage": "^1.2.3"
	},
	"retoldBeacon": {
		"displayName": "Ultravisor Auth Beacon",
		"description": "Pluggable identity for an ultravisor mesh. Validates credentials, mints sessions, and admits other beacons in non-promiscuous mode.",
		"category": "security",
		"mode": "standalone-service",
		"bin": "bin/ultravisor-auth-beacon.js",
		"argTemplate": [
			"--ultravisor",
			{
				"fromLabPath": "UltravisorURL"
			},
			"--name",
			{
				"fromLabPath": "BeaconName"
			},
			"--join-secret",
			{
				"fromLabPath": "JoinSecret"
			},
			"--bootstrap-admin-token",
			{
				"fromLabPath": "JoinSecret"
			}
		],
		"defaultPort": 0,
		"requiresUltravisor": true,
		"configForm": {
			"Fields": []
		}
	}
}
